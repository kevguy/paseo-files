{
  "id": "paseo-files",
  "name": "Files & Notes",
  "description": "Find files, read Markdown and edit notes or code from your phone.",
  "requirements": {
    "paseo": ">=0.16.1"
  },
  "build": [
    [
      "npm",
      "ci",
      "--omit=dev",
      "--ignore-scripts",
      "--no-audit",
      "--no-fund"
    ]
  ],
  "media": [
    "docs/screenshots/desktop-split-vim-normal.png",
    "docs/screenshots/files-phone.gif",
    "docs/screenshots/mobile-markdown.png"
  ]
}
